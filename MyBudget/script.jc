// My Budget - Main JavaScript

let incomeTotal = 0;
let giftTotal = 0;
let cardTotal = 0;

// Update the income summary
function updateIncomeSummary() {
    document.getElementById("income-total").textContent =
        "$" + incomeTotal.toFixed(2);

    document.getElementById("gift-total").textContent =
        "$" + giftTotal.toFixed(2);

    document.getElementById("card-total").textContent =
        "$" + cardTotal.toFixed(2);

    let spendableTotal = incomeTotal + giftTotal + cardTotal;

    document.getElementById("spendable-total").textContent =
        "$" + spendableTotal.toFixed(2);
}

// Add regular income
document.getElementById("income-form").addEventListener("submit", function(event) {
    event.preventDefault();

    let amount = parseFloat(document.getElementById("income-amount").value);

    if (!isNaN(amount) && amount >= 0) {
        incomeTotal += amount;
        updateIncomeSummary();
        this.reset();
    }
});

// Add money gift
document.getElementById("gift-form").addEventListener("submit", function(event) {
    event.preventDefault();

    let amount = parseFloat(document.getElementById("gift-amount").value);

    if (!isNaN(amount) && amount >= 0) {
        giftTotal += amount;
        updateIncomeSummary();
        this.reset();
    }
});

// Add gift card or prepaid card
document.getElementById("card-form").addEventListener("submit", function(event) {
    event.preventDefault();

    let amount = parseFloat(document.getElementById("card-balance").value);

    if (!isNaN(amount) && amount >= 0) {
        cardTotal += amount;
        updateIncomeSummary();
        this.reset();
    }
});

// Display the starting totals
updateIncomeSummary();

// Log Out confirmation
const logoutButton = document.getElementById("logout-button");

if (logoutButton) {
    logoutButton.addEventListener("click", function() {
        const confirmLogout = confirm("Do you want to log out?");

        if (confirmLogout) {
            // Log-out action will go here
        }
    });
}


// Warn before leaving the site
window.addEventListener("beforeunload", function(event) {
    event.preventDefault();
    event.returnValue = "";
});


// Warn when clicking a link that leaves the site
const links = document.querySelectorAll("a");

links.forEach(function(link) {
    link.addEventListener("click", function(event) {
        const destination = new URL(link.href, window.location.href);

        if (destination.origin !== window.location.origin) {
            const leaveSite = confirm(
                "You are about to leave My Budget. Do you want to continue?"
            );

            if (!leaveSite) {
                event.preventDefault();
            }
        }
    });
});
